# Local development: `cp .env.example .env`, fill AI_API_KEY, then `cargo run`.
DATABASE_URL=postgres://postgres:test@127.0.0.1:15432/news?sslmode=disable
PUBLIC_BASE_URL=http://127.0.0.1:8788/
# All accounts use /me/; admins manage public topics, other emails start on Free.
NEWS_ADMIN_EMAILS=you@example.com
# Development login links are printed in the response instead of being emailed.
EMAIL_LOGIN_DEV_LINKS=true
# Empty: no Redis (memory + PostgreSQL only, no login emails).
REDIS_ADDR=
AI_BASE_URL=https://api.zairouter.com
AI_API_KEY=
AI_DEFAULT_MODEL=grok-4.7
AI_INSIGHT_MODEL=gpt-6-astra
# XAI 日报每天按 NEWS_TIMEZONE 在此时开始补采最近24小时，完成后生成。
NEWS_BRIEFING_TIME=06:00
# Maximum time per collection or daily-generation request.
NEWS_FETCH_TIMEOUT_SECS=1800
# false: serve the API and pages without fetching (no AI spend).
NEWS_SCHEDULER_ENABLED=true
NEWS_TIMEZONE=Asia/Shanghai
# News items older than this many days are removed automatically.
NEWS_RETENTION_DAYS=128

# Required server-side media storage. The key is used only by NEWS when uploading to tmpfile.
TMPFILE_BASE_URL=https://dl.xabcnews.com
TMPFILE_API_KEY=replace-with-tmpfile-api-key
NEWS_IMAGE_MAX_BYTES=8388608
# Download + upload budget per image; each batch is capped at 90 seconds.
NEWS_IMAGE_TIMEOUT_SECS=30

# Optional locally. Production payment uses the YPay store-token tenant.
YPAY_BASE_URL=
YPAY_TENANT_CODE=news
YPAY_STORE_API_KEY=
PAYMENT_WEBHOOK_SECRET=

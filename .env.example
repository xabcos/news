# Local development: `cp .env.example .env`, fill AI_API_KEY, then `cargo run`.
DATABASE_URL=postgres://postgres:test@127.0.0.1:15432/news?sslmode=disable
PUBLIC_BASE_URL=http://127.0.0.1:8788/
# Admins are comma-separated; every other valid email can use /me/ as a Free account.
NEWS_ADMIN_EMAILS=you@example.com
# Development login links are printed in the response instead of being emailed.
EMAIL_LOGIN_DEV_LINKS=true
# Empty: no Redis (memory + PostgreSQL only, no login emails).
REDIS_ADDR=
AI_BASE_URL=https://api.zairouter.com
AI_API_KEY=
# false: serve the API and pages without fetching (no AI spend).
NEWS_SCHEDULER_ENABLED=true
NEWS_TIMEZONE=Asia/Shanghai

# Optional locally. Production payment uses the YPay store-token tenant.
YPAY_BASE_URL=
YPAY_TENANT_CODE=news
YPAY_STORE_API_KEY=
YPAY_PAY_METHOD=native
PAYMENT_WEBHOOK_SECRET=

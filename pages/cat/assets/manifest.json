{
  "version": 2,
  "style": "original-warm-hand-drawn-watercolor-travel-cat",
  "layers": {
    "room": {
      "home_awake": "room/room-day.webp",
      "home_sleeping": "room/room-night.webp",
      "rain": "room/room-rain.webp"
    },
    "character": {
      "base_idle": "character/cat-base.webp",
      "status": "hand-drawn-raster-coat-map-with-svg-identity-fallback",
      "identity_fields": [
        "coat",
        "eye_color",
        "marking",
        "initial_accessories"
      ],
      "visual_identity": ["coat", "identity_meta"],
      "selectors": {
        "coat": "data-coat",
        "eye_color": "data-eye",
        "marking": "data-marking",
        "initial_accessories": "data-accent"
      },
      "markings": {
        "star": "inline-svg:.cat-marking--star",
        "stripe": "inline-svg:.cat-marking--stripe",
        "cloud": "inline-svg:.cat-marking--cloud",
        "heart": "inline-svg:.cat-marking--heart"
      },
      "realistic_coats": {
        "orange_white": "character/cat-realistic-orange-white.webp",
        "cream_tabby": "character/cat-realistic-cream-tabby.webp",
        "silver_tabby": "character/cat-realistic-silver-tabby.webp",
        "black_white": "character/cat-realistic-black-white.webp"
      }
    }
  },
  "fallback": "css-prototype",
  "notes": "The four immutable coat variants use matching transparent hand-drawn watercolor illustrations. Eye color, marking and initial accessories remain driven by the locked server identity and are shown in the identity metadata; the deterministic SVG remains the fallback when a raster asset cannot load."
}
